<?xml version="1.0" encoding="UTF-8"?>
<effect name="Colorize" category="Color">
	<row name="Hue">
		<field type="double" min="0" default="30" max="360" id="hue"/>
	</row>
	<row name="Saturation">
		<field type="double" min="0" default="50" max="100" id="saturation"/>
	</row>
	<row name="Lightness">
		<field type="double" min="-100" default="0" max="100" id="lightness"/>
	</row>
	<shader vert="common.vert" frag="colorize.frag"/>
</effect>
