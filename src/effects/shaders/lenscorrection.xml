<?xml version="1.0" encoding="UTF-8"?>
<effect name="Lens Correction" category="Distort">
	<row name="Center">
		<field type="double" default="0" id="center_x"/>
		<field type="double" default="0" id="center_y"/>
	</row>
	<row name="K1">
		<field type="double" min="-100" default="0" max="100" id="k1"/>
	</row>
	<row name="K2">
		<field type="double" min="-100" default="0" max="100" id="k2"/>
	</row>
	<row name="Zoom">
		<field type="double" min="10" default="100" max="400" id="zoom"/>
	</row>
	<shader vert="common.vert" frag="lenscorrection.frag"/>
</effect>
