// Classic plasma generator, iTime-animated
#define PI 3.14159265
#define WAVE(a, b) sin((a) * (b) + iTime)

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 uv = fragCoord / iResolution.xy;
  float v = WAVE(uv.x, 10.0) + WAVE(uv.y, 7.0) + sin((uv.x + uv.y) * 8.0 + iTime * 1.3);
  v += sin(length(uv - 0.5) * 14.0 - iTime * 2.0);
  vec3 col = 0.5 + 0.5 * cos(PI * v + vec3(0.0, 2.0, 4.0));
  fragColor = vec4(col, 1.0);
}
